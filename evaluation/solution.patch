+/**
+ * Local JSON storage for chat sessions and their message history.
+ *
+ * Sessions live in `.ui_data/sessions.json`, keyed by id. The file is the whole
+ * database: it is read in full, mutated, and written back on every change.
+ */
+
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+import { randomUUID } from 'node:crypto';
+import type { Message, Session, SessionMap } from './types.js';
+
+export const DATA_DIR = '.ui_data';
+export const SESSIONS_FILE = path.join(DATA_DIR, 'sessions.json');
+
+function now(): string {
+  return new Date().toISOString();
+}
+
+function ensureStorage(): void {
+  fs.mkdirSync(DATA_DIR, { recursive: true });
+  if (!fs.existsSync(SESSIONS_FILE)) {
+    fs.writeFileSync(SESSIONS_FILE, '{}', 'utf-8');
+  }
+}
+
+function loadAll(): SessionMap {
+  ensureStorage();
+  try {
+    return JSON.parse(fs.readFileSync(SESSIONS_FILE, 'utf-8')) as SessionMap;
+  } catch {
+    // A truncated or hand-edited file must not take the app down with it.
+    return {};
+  }
+}
+
+function saveAll(data: SessionMap): void {
+  ensureStorage();
+  fs.writeFileSync(SESSIONS_FILE, JSON.stringify(data, null, 2), 'utf-8');
+}
+
+/** Make an empty session and return its id. */
+export function createSession(title = 'New Task'): string {
+  const data = loadAll();
+  const id = randomUUID().slice(0, 8);
+  const stamp = now();
+  data[id] = {
+    id,
+    title,
+    created_at: stamp,
+    updated_at: stamp,
+    messages: [],
+    status: 'idle',
+  };
+  saveAll(data);
+  return id;
+}
+
+export function getSession(sessionId: string): Session | null {
+  return loadAll()[sessionId] ?? null;
+}
+
+/** Every session, newest activity first. */
+export function getAllSessions(): Session[] {
+  return Object.values(loadAll()).sort((a, b) => {
+    const left = a.updated_at || a.created_at || '';
+    const right = b.updated_at || b.created_at || '';
+    return right.localeCompare(left);
+  });
+}
+
+/** Replace a session's messages and status. Unknown ids are ignored. */
+export function updateSession(
+  sessionId: string,
+  messages: Message[],
+  status = 'idle',
+  title?: string,
+): void {
+  const data = loadAll();
+  const session = data[sessionId];
+  if (!session) return;
+  session.messages = messages;
+  session.status = status;
+  session.updated_at = now();
+  if (title) session.title = title;
+  saveAll(data);
+}
+
+export function deleteSession(sessionId: string): void {
+  const data = loadAll();
+  if (data[sessionId] !== undefined) {
+    delete data[sessionId];
+    saveAll(data);
+  }
+}
