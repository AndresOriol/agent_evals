@@ -0,0 +1,35 @@
+"""What every bot has in common.
+
+A bot scores each lane and takes the best-scoring one. `Bot` owns that loop;
+a subclass supplies `score` and, if it needs one, a different tie-break.
+"""
+
+
+class Bot:
+    """The shared decision loop."""
+
+    def score(self, index, value, state):
+        """This bot's score for one lane. Higher wins."""
+        raise NotImplementedError
+
+    def tie_break(self):
+        """Which index wins when two lanes score the same: "low" or "high"."""
+        return "low"
+
+    def decide(self, state):
+        """The index of the lane this bot takes this turn."""
+        keep_later = self.tie_break() == "high"
+        best = None
+        choice = None
+        for index, value in enumerate(state["lanes"]):
+            current = self.score(index, value, state)
+            if current is None:
+                continue
+            if best is None or current > best or (keep_later and current == best):
+                best = current
+                choice = index
+        return self.fallback(state) if choice is None else choice
+
+    def fallback(self, state):
+        """The lane to take when this bot scored none of them."""
+        return 0
