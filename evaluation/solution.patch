index 0000000..9fc4f77
--- /dev/null
+++ b/dist/prompt.js
@@ -0,0 +1,47 @@
+/**
+ * Flatten a conversation into the single prompt the agent reads on stdin.
+ *
+ * The agent is a one-shot process: it gets one block of text and exits at EOF,
+ * so a multi-turn chat has to be replayed as one string on every turn.
+ */
+export const ROLE_LABELS = {
+    user: 'User',
+    assistant: 'Assistant',
+    system: 'System',
+};
+/** The display label for a role. Anything unrecognised reads as `User`. */
+export function labelFor(role) {
+    return ROLE_LABELS[role] ?? 'User';
+}
+/**
+ * One prompt from the whole history, oldest first.
+ *
+ * Messages with empty content are dropped: a blank turn adds a stray label and
+ * nothing else, and the agent reads it as an instruction with no content.
+ */
+export function combine(messages) {
+    const parts = [];
+    for (const message of messages) {
+        const content = (message.content ?? '').trim();
+        if (!content)
+            continue;
+        parts.push(`${labelFor(message.role ?? 'user')}: ${content}`);
+    }
+    return parts.join('\n\n');
+}
+/**
+ * A session title from its first prompt, trimmed to `limit`.
+ *
+ * Trimmed on a word boundary where there is one, so a title does not end
+ * mid-word; an over-long single word is cut where it must be.
+ */
+export function titleFrom(prompt, limit = 40) {
+    const text = prompt.split(/\s+/).filter(Boolean).join(' ');
+    if (text.length <= limit) {
+        return text || 'New Task';
+    }
+    const head = text.slice(0, limit);
+    const space = head.lastIndexOf(' ');
+    const cut = space === -1 ? '' : head.slice(0, space);
+    return `${cut || head}...`;
+}
diff --git a/dist/runner.js b/dist/runner.js
new file mode 100644
index 0000000..586994e
--- /dev/null
+++ b/dist/runner.js
@@ -0,0 +1,51 @@
+/**
+ * How the UI launches the coding agent.
+ *
+ * The contract is fixed and not ours to change: `python -m agent.code
+ * <workspace>`, the whole prompt on stdin, EOF ends the task, exit code 0 means
+ * success. This module builds the invocation and reads the result; it never
+ * runs anything itself, so it stays testable without spawning a process.
+ */
+export const DONE_MARKER = '=== DONE';
+export const STOPPED_MARKER = '=== STOPPED';
+/** The argv for one agent run over `workspace`. */
+export function buildCommand(workspace, executable = 'python') {
+    if (!workspace) {
+        throw new Error('a workspace is required');
+    }
+    return [executable, '-m', 'agent.code', workspace];
+}
+/**
+ * The agent's own answer, without the run log around it.
+ *
+ * Everything before the end marker is the router's log -- routing lines, HTTP
+ * statuses, token counts. Replaying that back into the next prompt costs the
+ * conversation its context window and tells the model nothing, so only the tail
+ * after the marker is kept.
+ */
+export function extractReply(output) {
+    for (const marker of [DONE_MARKER, STOPPED_MARKER]) {
+        const index = output.lastIndexOf(marker);
+        if (index === -1)
+            continue;
+        const tail = output.slice(index).split('===');
+        if (tail.length >= 3) {
+            return tail.slice(2).join('===').trim();
+        }
+    }
+    return output.trim();
+}
+/**
+ * What to record as the assistant's message when a run ends.
+ *
+ * A stop the user asked for, a crash and a clean finish are three different
+ * things, and reporting all of them as one loses the only clue about which
+ * happened.
+ */
+export function describeExit(code, userStopped = false) {
+    if (userStopped)
+        return 'Stopped by the user.';
+    if (code === 0)
+        return 'completed';
+    return `Agent exited with code ${code}.`;
+}
