+}
+
+export type SessionStatus = 'idle' | 'working' | 'completed' | 'error';
+
+export interface Session {
+  id: string;
+  title: string;
+  created_at: string;
+  updated_at: string;
+  messages: Message[];
+  status: string;
+}
+
+export type SessionMap = Record<string, Session>;
