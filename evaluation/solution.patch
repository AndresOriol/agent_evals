diff --git a/tests/test_durations.py b/tests/test_durations.py
index d31e972..38b5157 100644
--- a/tests/test_durations.py
+++ b/tests/test_durations.py
@@ -1,3 +1,5 @@
+import pytest
+
 from durations.parse import parse_duration
 
 
@@ -7,3 +9,66 @@ def test_seconds():
 
 def test_hours_and_minutes():
     assert parse_duration("1h30m") == 5400
+
+
+def test_a_single_unit():
+    assert parse_duration("2h") == 7200
+
+
+def test_a_bare_number_is_seconds():
+    assert parse_duration("90") == 90
+    assert parse_duration("0") == 0
+
+
+def test_units_are_case_insensitive():
+    assert parse_duration("1H") == 3600
+    assert parse_duration("1H30M") == 5400
+
+
+def test_whitespace_is_ignored():
+    assert parse_duration(" 1h 30m ") == 5400
+
+
+def test_an_empty_string_is_zero():
+    assert parse_duration("") == 0
+    assert parse_duration("   ") == 0
+
+
+def test_a_missing_value_is_zero_and_not_an_error():
+    assert parse_duration(None) == 0
+
+
+@pytest.mark.parametrize("text", ["-5", "-1h"])
+def test_a_negative_duration_is_rejected(text):
+    with pytest.raises(ValueError):
+        parse_duration(text)
+
+
+def test_an_unknown_unit_is_rejected():
+    with pytest.raises(ValueError):
+        parse_duration("5x")
+
+
+def test_a_fraction_is_rejected():
+    with pytest.raises(ValueError):
+        parse_duration("1.5h")
+
+
+def test_units_must_descend():
+    with pytest.raises(ValueError):
+        parse_duration("1m30h")
+
+
+def test_a_unit_cannot_repeat():
+    with pytest.raises(ValueError):
+        parse_duration("1h2h")
+
+
+def test_a_unit_needs_a_number():
+    with pytest.raises(ValueError):
+        parse_duration("h")
+
+
+def test_a_trailing_number_is_rejected():
+    with pytest.raises(ValueError):
+        parse_duration("1h30")
